# SQLite file. Locally relative to the cms folder, when hosting on the persistent volume,
# e.g. file:/data/tripnjungle.db
DATABASE_URI=file:./tripnjungle.db

# Folder for uploaded images/videos. Locally "media", when hosting e.g. /data/media
MEDIA_DIR=media

# Long random string (e.g. openssl rand -hex 32). Never share it.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public address of the site, without a trailing slash. Canonical URLs, sitemap,
# Open Graph links and QR codes are built from it. Locally: http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# ---------- Shop (release 3.0) ----------
# Stripe: Dashboard → Developers → API keys (test mode sk_test_…, live sk_live_…).
# Without both values the shop stays closed, even if it is switched on in the Site settings.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint https://your-domain.com/shop/webhook with the events
# checkout.session.completed, .async_payment_succeeded, .async_payment_failed and .expired.
# Locally "stripe listen --forward-to localhost:3000/shop/webhook" prints a whsec_… to use here.
STRIPE_WEBHOOK_SECRET=

# ---------- E-mail (order confirmations, shipping notices, "Forgot password") ----------
# SMTP of your mail provider. Without SMTP_HOST no e-mail is sent: they are written to the log.
# Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender, e.g. shop@your-domain.com (empty = SMTP_USER)
EMAIL_FROM=
EMAIL_FROM_NAME=Tripnjungle
