# SQLite file. Locally relative to the cms folder, when hosting on the persistent volume,
# e.g. file:/data/tripnjungle.db
DATABASE_URI=file:./tripnjungle.db

# Folder for uploaded images/videos. Locally "media", when hosting e.g. /data/media
MEDIA_DIR=media

# Long random string (e.g. openssl rand -hex 32). Never share it.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public address of the site, without a trailing slash. Canonical URLs, sitemap,
# Open Graph links and QR codes are built from it. Locally: http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
